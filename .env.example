# ── Database (own, separate PostgreSQL — not shared with Ludeva) ──
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/lchama?schema=public"

# ── Clerk (own, separate Clerk project — not shared with Ludeva) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── App URL (used in invite emails) ──
NEXT_PUBLIC_APP_URL="https://lchama.ludevaplc.co.ke"

# ── Platform admins who can approve/reject submitted organisations ──
# Comma-separated Clerk user IDs (find these in the Clerk dashboard under
# each user). This is deliberately not a database role — see
# src/lib/admin.ts for why.
ADMIN_CLERK_IDS="user_xxxxxxxxxxxx"

# ── Email (Resend) ──
# RESEND_API_KEY must belong to the Resend account that has verified the
# domain you send from. EMAIL_FROM_ADDRESS's domain MUST be verified
# under that same account (Resend dashboard → Domains) — otherwise
# invite emails fail silently from the sender's point of view. This is
# the actual cause if invite emails aren't arriving: check Domains in
# the Resend account tied to this key, and set EMAIL_FROM_ADDRESS to an
# address on a domain shown there as "Verified".
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="L-CHAMA <noreply@ludevaplc.co.ke>"

# ── File storage (Cloudflare R2) — for Junior Account documents, etc. ──
# Same R2 setup style as the main Ludeva app. Leave unset and uploads
# will fail with a clear "storage not configured" error instead of
# silently corrupting data.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Google Sheets member-report sync ──
# Shared secret an Apps Script sends as the `x-sync-secret` header when
# pushing rows to POST /api/member-reports/sync. Leave unset in
# development to accept unauthenticated pushes.
MEMBER_REPORTS_SYNC_SECRET=""

# ── Ludeva connection ──
# L Chama is a standalone app/database, but pushes a read-only snapshot
# of each chama (name, level, member count, pool balance) to Ludeva's
# ExternalChama mirror whenever it's approved or its membership/pool
# changes — see src/lib/ludeva-sync.ts and Ludeva's
# /api/lchama/webhook. Leave LUDEVA_SYNC_URL unset to skip syncing.
LUDEVA_SYNC_URL="https://ludevaplc.co.ke/api/lchama/webhook"
LCHAMA_SYNC_SECRET=""
