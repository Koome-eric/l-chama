// L Chama — standalone schema, spun out of Ludeva.
// This app has its own database and its own Clerk project, so this User
// model only carries what L Chama itself needs — no KYC, no investment,
// no accountType fields from the original Ludeva schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LudevaMembershipStatus {
  NONE // didn't claim to be an existing Ludeva Plc member
  PENDING // claimed membership, number submitted, awaiting admin confirmation
  VERIFIED // admin confirmed the Ludeva membership number
  REJECTED // admin could not confirm the claimed number
}

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique
  email   String? @unique
  phone   String? @unique

  fullName  String?
  firstName String?
  lastName  String?
  idNumber  String?
  gender    Gender?
  country   String?
  region    String?

  role UserRole @default(MEMBER)

  // Two distinct completion flags: a person can be phone-verified and
  // even have finished their personal profile without yet having a
  // chama (owner) or being on one (member) — onboardingCompleted only
  // flips once they're attached to a team one way or another.
  profileCompleted    Boolean @default(false)
  onboardingCompleted Boolean @default(false)

  // Self-claimed at onboarding (required only if the person says they're
  // an existing Ludeva Plc member), then confirmed or rejected by a
  // platform admin (see /admin) before it counts toward anything. Drives
  // the withdrawal fee rate for external-chama and campaign withdrawals
  // — see src/lib/withdrawal-fee.ts. NONE means "didn't claim to be a
  // member" (most new sign-ups), not "checked and found not to be one".
  ludevaMemberNumber           String?
  ludevaMembershipStatus       LudevaMembershipStatus @default(NONE)
  ludevaMembershipDecidedAt    DateTime?
  ludevaMembershipRejectionReason String?

  ownedTeam      Team?           @relation("TeamOwner")
  teamMembership TeamMembership? @relation("TeamMembershipUser")
  sentInvites    TeamInvite[]    @relation("TeamInvitesSentBy")
  decidedTeams   Team[]          @relation("TeamDecidedBy")

  loanRequestsMade    LoanRequest[]   @relation("LoanRequester")
  loanRequestsDecided LoanRequest[]   @relation("LoanDecidedBy")
  loanGuarantees      LoanGuarantee[] @relation("LoanGuarantor")

  lastRespectClaimsMade    LastRespectClaim[] @relation("LastRespectClaimant")
  lastRespectClaimsDecided LastRespectClaim[] @relation("LastRespectDecidedBy")

  campaignsCreated Campaign[] @relation("CampaignCreator")
  donationsMade    Donation[] @relation("DonationDonor")
  teamInvestmentsMade TeamInvestment[] @relation("TeamInvestmentInitiator")

  // ── Signatory roles — see WithdrawalRequest below. A chama's Admin is
  // just its owner; a campaign's Admin is just its creator. Secretary and
  // Treasurer are each a single additional member the Admin designates. ──
  secretaryOfTeams     Team[]     @relation("TeamSecretary")
  treasurerOfTeams     Team[]     @relation("TeamTreasurer")
  secretaryOfCampaigns Campaign[] @relation("CampaignSecretary")
  treasurerOfCampaigns Campaign[] @relation("CampaignTreasurer")

  withdrawalsRequested WithdrawalRequest[]  @relation("WithdrawalRequestedBy")
  withdrawalApprovals  WithdrawalApproval[] @relation("WithdrawalApprover")

  // Personal Ludeva accounts (Shares/Savings/Junior) — separate from a
  // chama's pooled TeamInvestment, these belong to the member directly.
  memberAccounts MemberAccount[]
  payments       Payment[]

  juniorApplications         JuniorAccountApplication[] @relation("JuniorGuardian")
  juniorApplicationsReviewed JuniorAccountApplication[] @relation("JuniorReviewer")

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

enum OrganisationApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// What a chama is saving towards — answered by the Team Leader at
// account opening (multi-select).
enum ChamaObjective {
  BUY_ASSETS
  GET_A_LOAN
  GET_INTEREST
  SCHOOL_FEES
  DECEMBER_HOLIDAY
}

model Team {
  id      String @id @default(cuid())
  name    String
  photoUrl String?
  ownerId String @unique
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id])

  levelKey      String?
  levelName     String?
  monthlyAmount Float?
  groupSize     Int?

  // Organisation registration details, collected on the "Register
  // Organisation" onboarding step and reviewed by an admin before the
  // chama goes live.
  businessRegNumber  String?
  numberOfMembers    Int?
  totalDirectors     Int?
  physicalAddress    String?
  additionalComments String?

  // Kenya-diaspora support: most members contribute from outside Kenya.
  // Purely informational (currency/logistics are still handled the same
  // way) but drives a "Diaspora Chama" badge and lets admins see which
  // chamas need diaspora-specific support.
  isDiaspora Boolean @default(false)

  // Set by a platform admin only (see /admin → Organisations), never by
  // the chama itself. A Ludeva-member chama withdraws by emailing
  // lchama@ludevaplc.co.ke / invst@ludevaplc.co.ke instead of the in-app
  // 3-signatory flow, and pays no platform withdrawal fee — that flow
  // and its flat fee (see PLATFORM_WITHDRAWAL_FEE_RATE) are for external
  // / non-member chamas only. Defaults to false (external) since that's
  // every chama that signs up on this platform on its own.
  isLudevaMember Boolean @default(false)

  // ── Onboarding questions answered by the Team Leader at signup ──
  // What is this chama saving towards? Multi-select, stored as the
  // ChamaObjective enum values below.
  objectives ChamaObjective[] @default([])
  // "What is the background of half your members?" — a rough split the
  // Team Leader estimates at signup, not a running member-by-member tally.
  membersRunningSME Int?
  membersEmployed   Int?

  // ── Last Respect Cover — an opt-in bereavement/last-expense benefit
  // funded by its own pool, separate from the loan account. ──
  hasLastRespectCover     Boolean @default(false)
  lastRespectContribution Float? // KES each member contributes towards the cover
  lastRespectFund         LastRespectFund?
  lastRespectClaims       LastRespectClaim[]

  approvalStatus OrganisationApprovalStatus @default(PENDING_APPROVAL)
  submittedAt    DateTime                   @default(now())
  decidedById    String?
  decidedBy      User?                      @relation("TeamDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  rejectionReason String?

  // ── Withdrawal signatories (see WithdrawalRequest) — the owner is the
  // implicit Admin signatory; these two are member-assigned. Pooled-fund
  // withdrawals need all three signing off before money moves. ──
  secretaryId String?
  secretary   User?   @relation("TeamSecretary", fields: [secretaryId], references: [id])
  treasurerId String?
  treasurer   User?   @relation("TeamTreasurer", fields: [treasurerId], references: [id])

  members         TeamMembership[]
  invites         TeamInvite[]
  loanAccount     LoanAccount?
  loanRequests    LoanRequest[]
  investments     TeamInvestment[]
  memberReports   MemberReport[]
  savingsEntries  SavingsEntry[]
  withdrawals     WithdrawalRequest[]
  loanDeposits    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team")
}

// ✅ Per-member custom permissions within a chama. The owner ("Admin")
// implicitly has every permission regardless of these flags — they only
// apply to invited members, and are set by the owner (or by another
// member with canManagePermissions) either at invite time or afterward
// from the Members tab. All default to a sensible baseline so a newly
// invited member only gets what the inviter grants.
model TeamMembership {
  id     String @id @default(cuid())
  teamId String
  userId String @unique

  team Team @relation(fields: [teamId], references: [id])
  user User @relation("TeamMembershipUser", fields: [userId], references: [id])

  canInvite            Boolean @default(false) // send new chama invites
  canManagePermissions Boolean @default(false) // edit other members' roles/permissions
  canRemoveMembers     Boolean @default(false) // remove members from the chama
  canApproveLoans      Boolean @default(false) // approve/reject loan requests, record repayments
  canInvestPooled      Boolean @default(false) // move pooled funds into an investment product
  canViewPooledFunds   Boolean @default(true)  // view the loan account & investment balances
  canManageReports     Boolean @default(false) // upload/sync Google Sheets performance data
  canWithdraw          Boolean @default(false) // close out an investment back to the pooled fund

  createdAt DateTime @default(now())

  @@map("teammembership")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model TeamInvite {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  email       String
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  invitedBy   User         @relation("TeamInvitesSentBy", fields: [invitedById], references: [id])

  // Permissions to grant on acceptance — mirrors TeamMembership flags, so
  // the owner picks the member's role while sending the invite.
  canInvite            Boolean @default(false)
  canManagePermissions Boolean @default(false)
  canRemoveMembers     Boolean @default(false)
  canApproveLoans      Boolean @default(false)
  canInvestPooled      Boolean @default(false)
  canViewPooledFunds   Boolean @default(true)
  canManageReports     Boolean @default(false)
  canWithdraw          Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("teaminvite")
}

model LoanAccount {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id])

  balance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loanaccount")
}

enum LoanRequestStatus {
  PENDING_GUARANTORS
  PENDING_ADMIN
  REJECTED
  ACTIVE
  REPAID
}

model LoanRequest {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  requesterId String
  requester   User   @relation("LoanRequester", fields: [requesterId], references: [id])

  amount  Float
  purpose String?
  status  LoanRequestStatus @default(PENDING_GUARANTORS)

  // Fixed chama loan formula (not admin-chosen): 2.5% per month of the
  // loan term, term capped at 6 months, repaid weekly (term months x 4
  // weeks). See computeLoanTerms() in actions.ts — the single place this
  // formula is applied, so admin approval never overrides it.
  months       Int?   // requested/approved term in months, 1-6
  interestRate Float  @default(2.5) // total % for the whole term (2.5 x months)

  repaymentWeeks Int?

  // 2.5% of the loan amount, payable upfront before disbursement —
  // separate from the weekly interest+principal repayment schedule.
  processingFee      Float   @default(0)
  processingFeePaid  Boolean @default(false)
  processingFeePaidAt DateTime?

  decidedById String?
  decidedBy   User?     @relation("LoanDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  guarantees LoanGuarantee[]
  repayments LoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loanrequest")
}

model LoanGuarantee {
  id            String      @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id])

  guarantorId String
  guarantor   User   @relation("LoanGuarantor", fields: [guarantorId], references: [id])

  // E-signature: the guarantor types their full legal name to confirm the
  // guarantee — captured alongside createdAt as the signed timestamp.
  signatureName String

  createdAt DateTime @default(now())

  @@unique([loanRequestId, guarantorId])
  @@map("loanguarantee")
}

model LoanRepayment {
  id            String      @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id])

  weekNumber Int
  dueDate    DateTime
  amount     Float
  paid       Boolean   @default(false)
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loanrepayment")
}

// ─────────────────────────────────────────────
// Last Respect Cover — an opt-in bereavement/last-expense benefit. Each
// chama that enables it (Team.hasLastRespectCover) gets its own fund,
// separate from the loan account, that members contribute to
// (Team.lastRespectContribution per member) and can claim from when a
// member or their immediate family passes away.
// ─────────────────────────────────────────────
model LastRespectFund {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id])

  balance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lastrespectfund")
}

enum LastRespectClaimStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model LastRespectClaim {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  claimantId String
  claimant   User   @relation("LastRespectClaimant", fields: [claimantId], references: [id])

  deceasedName String
  relation     String // e.g. "Self (member)", "Spouse", "Child", "Parent"
  amount       Float
  notes        String?
  status       LastRespectClaimStatus @default(PENDING)

  decidedById String?
  decidedBy   User?     @relation("LastRespectDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lastrespectclaim")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notification")
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

// Fundraising campaigns — separate from chama loans. Any onboarded
// member can start one; it's visible platform-wide (not scoped to a
// single chama) since these are community/charity causes, not
// chama-internal loans. "verified" is set by an admin (see
// isPlatformAdmin) and is purely a trust badge — it does not gate
// whether the campaign accepts donations.
model Campaign {
  id          String  @id @default(cuid())
  title       String
  description String // short summary shown on the card
  story       String // full story shown on the detail page
  category    String
  location    String

  targetAmount   Float
  raisedAmount   Float          @default(0) // only ever incremented by a SUCCESS donation
  withdrawnAmount Float         @default(0) // sum of PAID withdrawals — see WithdrawalRequest
  backersCount   Int            @default(0)
  beneficiaries  Int?
  imageUrl       String?
  verified       Boolean        @default(false)
  status         CampaignStatus @default(ACTIVE)
  deadline       DateTime

  creatorId String
  creator   User   @relation("CampaignCreator", fields: [creatorId], references: [id])

  // ── Withdrawal signatories (see WithdrawalRequest) — the creator is the
  // implicit Admin signatory; these two are creator-assigned. A payout of
  // donated funds needs all three signing off, same rule as a chama's
  // pooled funds. ──
  secretaryId String?
  secretary   User?   @relation("CampaignSecretary", fields: [secretaryId], references: [id])
  treasurerId String?
  treasurer   User?   @relation("CampaignTreasurer", fields: [treasurerId], references: [id])

  donations   Donation[]
  withdrawals WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaign")
}

// ─────────────────────────────────────────────
// Investment Products — the same catalog concept as Ludeva's
// InvestmentProduct (MMF, stocks, bonds, fixed deposits). L Chama runs
// its own database, so this is a local copy of the product catalog
// (managed by an L Chama admin) rather than a live cross-app join —
// see /admin's "Investment Products" tab. A chama invests pooled funds
// from its loan account into one of these via TeamInvestment.
// ─────────────────────────────────────────────
enum FundType {
  MMF
  STOCK
  BOND
  FIXED_DEPOSIT
  SAVINGS
  JUNIOR
}

model InvestmentProduct {
  id          String   @id @default(cuid())
  name        String
  type        FundType
  description String?
  roi         Float // annualized, % — the headline/minimum rate (e.g. 9 for "9–13% p.a.")
  roiMax      Float? // optional upper bound of the rate range
  duration    Int // months
  minAmount   Float
  maxAmount   Float?
  isActive    Boolean  @default(true)

  investments    TeamInvestment[]
  memberAccounts MemberAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investmentproduct")
}

enum TeamInvestmentStatus {
  ACTIVE
  COMPLETED
}

// A chama's pooled contribution into an InvestmentProduct. Investing
// moves cash out of the chama's LoanAccount balance into the product;
// closing it (canWithdraw) returns the principal to the loan account.
model TeamInvestment {
  id        String @id @default(cuid())
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id])
  productId String
  product   InvestmentProduct @relation(fields: [productId], references: [id])

  amount        Float
  status        TeamInvestmentStatus @default(ACTIVE)
  investedById  String
  investedBy    User                 @relation("TeamInvestmentInitiator", fields: [investedById], references: [id])

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("teaminvestment")
}

// ─────────────────────────────────────────────
// Personal Ludeva accounts — Shares, Savings, and Junior accounts a
// member opens for themselves (as opposed to TeamInvestment, which is
// the chama's shared pooled fund going into a product together). One
// account per member per product; funding it happens through Payment
// rows (M-Pesa or Visa card).
// ─────────────────────────────────────────────
enum MemberAccountStatus {
  ACTIVE
  CLOSED
}

model MemberAccount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   InvestmentProduct @relation(fields: [productId], references: [id])

  balance Float               @default(0)
  status  MemberAccountStatus @default(ACTIVE)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("memberaccount")
}

// ─────────────────────────────────────────────
// A payment attempt against a personal MemberAccount, over M-Pesa
// (STK push) or a Visa card. Both are processed through Paystack (see
// src/lib/paystack.ts) — created PENDING, then flipped to SUCCESS/
// FAILED by Paystack's webhook (src/app/api/payments/paystack/webhook)
// once the STK push/card checkout completes. `reference` is the id
// Paystack tracks the transaction under (we set it equal to this row's
// own id at creation). An admin can still resolve a stuck PENDING
// payment manually from /admin as a fallback.
// ─────────────────────────────────────────────
enum PaymentChannel {
  MPESA
  VISA_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// A payment INTO the platform — either topping up a personal
// MemberAccount (/accounts) or a chama's shared LoanAccount (/deposit).
// Exactly one of memberAccountId/teamId is set, matching which page it
// came from. See src/lib/payment-resolution.ts for how it's resolved.
model Payment {
  id String @id @default(cuid())

  userId          String
  user            User           @relation(fields: [userId], references: [id])
  memberAccountId String?
  memberAccount   MemberAccount? @relation(fields: [memberAccountId], references: [id])
  // Set instead of memberAccountId for a deposit into a chama's shared
  // LoanAccount (the /deposit page) rather than a personal MemberAccount
  // (the /accounts page). Exactly one of the two is set.
  teamId          String?
  team            Team?          @relation(fields: [teamId], references: [id])

  channel PaymentChannel
  amount  Float
  status  PaymentStatus @default(PENDING)

  phone     String? // M-Pesa number the STK push would go to
  reference String? @unique // gateway checkout/reference ID, once wired
  note      String? // admin note when manually resolving

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
}

// ─────────────────────────────────────────────
// Ludeva Junior Account application — a guardian applies on behalf of
// a child, uploading KYC documents for an admin to review manually.
// Files are stored in Cloudflare R2 (same storage the main Ludeva app
// uses for its KYC documents) via /api/upload-doc, so these fields hold
// public URLs, not file data. Approving creates the child's
// MemberAccount against the JUNIOR product.
// ─────────────────────────────────────────────
enum JuniorApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model JuniorAccountApplication {
  id String @id @default(cuid())

  guardianId String
  guardian   User   @relation("JuniorGuardian", fields: [guardianId], references: [id])

  childFullName   String
  childDateOfBirth DateTime?

  guardianIdNumber String
  guardianPhone    String
  guardianKraPin   String

  birthCertUrl  String // hosted file URL (Cloudflare R2 — see /api/upload-doc)
  childPhotoUrl String // hosted file URL (Cloudflare R2 — see /api/upload-doc)

  status       JuniorApplicationStatus @default(PENDING_REVIEW)
  reviewNotes  String?
  reviewedById String?
  reviewedBy   User?                   @relation("JuniorReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("junioraccountapplication")
}

// ─────────────────────────────────────────────
// Member performance rows synced in from Google Sheets (same pipeline
// idea as Ludeva's MemberReport — an Apps Script pushes rows to
// /api/member-reports/sync, or an admin pastes a CSV export in the
// admin "Member Reports" tab). teamId is resolved by matching
// memberEmail to a user on that chama; rows that don't match anyone yet
// are kept with teamId = null until an admin re-syncs.
// ─────────────────────────────────────────────
model MemberReport {
  id     String @id @default(cuid())
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id])

  memberEmail String
  memberName  String?

  date        String?
  principal   String?
  rate        String?
  roi         String?
  withdrawal  String?
  closingBal  String?
  periodLabel String?
  notes       String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("memberreport")
}

// Savings Account entries, fed from a dedicated "Savings Data" sheet in
// the same Excel workbook Ludeva already uses for Investments (separate
// tab, separate columns). L-Chama savings carry no interest — interest
// is reserved for members who hold a Ludeva Investment Account, not a
// normal L-Chama savings feature — so this is a plain running balance:
// each entry carries forward the previous closing balance, adds a
// deposit, subtracts a payout. Pushed in via the same
// Apps-Script-to-webhook pattern as MemberReport (see /api/savings/sync),
// or added/corrected by hand from the admin Savings screen.
model SavingsEntry {
  id     String @id @default(cuid())
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id])

  memberEmail String
  memberName  String?
  accountNo   String?

  date           String?
  openingBalance String?
  deposit        String?
  payout         String?
  closingBalance String?
  periodLabel    String?
  notes          String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("savingsentry")
}

// Donations are manually recorded (like the loan account's manual
// funding) rather than run through a real payment gateway — see the
// README note on this. donorName/anonymous let a signed-in donor choose
// how they're displayed on the campaign's donor list.
// A contribution to a Campaign. Anyone with the campaign's public link
// can give without an L Chama account — donorId is only set when a
// signed-in member gives; a guest's name/phone (for the receipt/ledger)
// is stored in guestName/guestPhone instead. Created PENDING and moved
// to SUCCESS/FAILED by the same Paystack webhook that resolves Payment
// rows (src/lib/donation-resolution.ts) — only a SUCCESS donation
// increments the campaign's raisedAmount/backersCount, so the progress
// bar never counts money that didn't actually arrive.
model Donation {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  donorId   String?
  donor     User?   @relation("DonationDonor", fields: [donorId], references: [id])
  anonymous Boolean @default(false)

  // Set for guest (non-member) donors instead of donorId.
  guestName  String?
  guestPhone String?

  amount  Float
  message String?

  channel   PaymentChannel @default(MPESA)
  status    PaymentStatus  @default(PENDING)
  reference String?        @unique // Paystack transaction reference

  createdAt DateTime @default(now())

  @@map("donation")
}

// ─────────────────────────────────────────────
// Three-signatory fund withdrawals — the same rule for both scopes a
// pool of money can live in on this platform:
//   - CAMPAIGN: a fundraising campaign's raised donations.
//   - CHAMA:    a chama's pooled LoanAccount balance.
// Each scope has exactly three signatories: an Admin (the campaign's
// creator, or the chama's owner), a Secretary, and a Treasurer (the
// latter two assigned by the Admin — see Campaign.secretary/treasurer
// and Team.secretary/treasurer). A withdrawal only pays out once all
// three have APPROVED; any single REJECTED stops it. The requester's
// own signatory vote is recorded as APPROVED automatically when they
// open the request — see src/lib/withdrawals.ts.
// ─────────────────────────────────────────────
enum WithdrawalScope {
  CAMPAIGN
  CHAMA
}

enum SignatoryRole {
  ADMIN
  SECRETARY
  TREASURER
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  AWAITING_APPROVALS // still needs one or more of the 3 signatures
  REJECTED           // any signatory rejected it
  PROCESSING         // fully approved, payout in flight via Paystack Transfer
  PAID               // payout confirmed
  FAILED             // payout attempt failed — see failureReason; an admin can retry/pay out manually
}

model WithdrawalRequest {
  id    String          @id @default(cuid())
  scope WithdrawalScope

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  teamId     String?
  team       Team?     @relation(fields: [teamId], references: [id])

  requestedById String
  requestedBy   User   @relation("WithdrawalRequestedBy", fields: [requestedById], references: [id])

  amount    Float // gross amount requested, deducted from the pool on PAID
  feeAmount Float @default(0) // platform fee — flat 5%, campaign or non-member chama alike
  netAmount Float // amount actually sent out (amount - feeAmount)

  destinationPhone String // M-Pesa number the payout is sent to
  reason           String?

  status WithdrawalStatus @default(AWAITING_APPROVALS)

  approvals WithdrawalApproval[]

  payoutReference String? @unique // Paystack transfer reference, once initiated
  failureReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("withdrawalrequest")
}

model WithdrawalApproval {
  id                  String            @id @default(cuid())
  withdrawalRequestId String
  withdrawalRequest   WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id])

  role       SignatoryRole
  approverId String
  approver   User          @relation("WithdrawalApprover", fields: [approverId], references: [id])

  decision  ApprovalDecision @default(PENDING)
  comment   String?
  decidedAt DateTime?

  createdAt DateTime @default(now())

  // One vote per role per request — the same person can't sign as both
  // Secretary and Treasurer even if they somehow ended up holding both.
  @@unique([withdrawalRequestId, role])
  @@map("withdrawalapproval")
}

// Password-based admin accounts, managed by the super admin (the
// ADMIN_EMAIL/ADMIN_PASSWORD pair from the environment — see
// src/lib/admin-auth.ts). The super admin itself is never a row here;
// this table only holds the additional admins it creates, so it can
// create/edit/delete them without ever being able to lock itself out.
model AdminAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String?
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_account")
}
